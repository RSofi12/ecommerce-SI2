{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "outputDirectory": "frontend/dist/frontend"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ecommerce-si2.onrender.com/api/$1",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "source": "/health",
      "destination": "https://ecommerce-si2.onrender.com/health"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

