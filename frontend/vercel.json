{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/frontend"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://ecommerce-si2.onrender.com/api/$1",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "src": "/health",
      "dest": "https://ecommerce-si2.onrender.com/health"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/frontend/$1"
    }
  ]
}
