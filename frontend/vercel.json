{
  "version": 2,
  "cleanUrls": true,
  "rootDirectory": "frontend",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "outputDirectory": "dist/frontend"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ecommerce-si2.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://ecommerce-si2.onrender.com/health"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

